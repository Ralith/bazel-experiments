bazel_dep(name = "rules_rs", version = "0.0.112")
bazel_dep(name = "llvm", version = "0.8.19")
bazel_dep(name = "platforms", version = "1.1.0")

# Needed for PyO3?
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")
rules_rust_pyo3 = use_extension("@rules_rs//rs:rules_rust_pyo3.bzl", "rules_rust_pyo3")
use_repo(rules_rust_pyo3, "rules_rust_pyo3")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    name = "rust",
    edition = "2024",
    version = "1.97.0",
)
use_repo(toolchains, "rust")

register_toolchains(
    "@rust//...",
    "@llvm//toolchain:all",
    #"@rules_rust//extensions/pyo3/toolchains:toolchain",
    #"@rules_rust//extensions/pyo3/toolchains:rust_toolchain",
    "//toolchain:toolchain",
    "//toolchain:rust_toolchain",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)

use_repo(crate, "crates")
